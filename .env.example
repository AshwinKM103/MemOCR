# Copy to `.env` (gitignored) and fill in real values for your host.
# Loaded by config/env.yaml via ${oc.env:VAR,default} interpolation, so any
# key you omit falls back to the default baked into that file.

# --- Storage paths (large artifacts; keep off small /home partitions) ---
MEMOCR_OUTPUT_ROOT=/mnt/ssd/users/durgesh/memocr/runs
MEMOCR_CHECKPOINT_ROOT=/mnt/ssd/users/durgesh/memocr/checkpoints
MEMOCR_CACHE_ROOT=/mnt/ssd/users/durgesh/memocr/cache
NLTK_DATA=/mnt/ssd/users/durgesh/nltk_data
EMBEDDING_MODEL_PATH=/mnt/ssd/users/durgesh/models/all-MiniLM-L6-v2
MEMOCR_QWEN_CHECKPOINT=/mnt/ssd/users/durgesh/models/Qwen2.5-VL-7B-Instruct

# --- GPU ---
CUDA_VISIBLE_DEVICES=0
WORLD_SIZE=1

# --- WandB ---
WANDB_ENTITY=c-aimms
WANDB_PROJECT=memocr
# online | offline | disabled
WANDB_MODE=disabled
WANDB_API_KEY=
